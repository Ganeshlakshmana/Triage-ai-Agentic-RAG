# ─────────────────────────────────────────────
# .env.example — Copy to .env and fill in your keys
# ─────────────────────────────────────────────
# Multi-provider routing: at least one key must be set.
# If a key is missing, that provider is skipped in the fallback chain.
# ─────────────────────────────────────────────

# Primary provider — Claude (Anthropic)
ANTHROPIC_API_KEY=sk-ant-...

# Secondary provider — OpenAI (gpt-4o-mini)
OPENAI_API_KEY=sk-...

# Tertiary provider — Gemini (gemini-2.0-flash)
GEMINI_API_KEY=AIza...

# Default provider: "claude" | "openai" | "gemini" | "auto"
# "auto" = try Claude first, fall back to OpenAI, then Gemini
DEFAULT_PROVIDER=auto